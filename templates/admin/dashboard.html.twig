{% extends 'admin/base.html.twig' %}
{% import 'admin/_icons.html.twig' as icons %}
{% import 'admin/_dashboard.html.twig' as dashboard %}

{% block title %}Přehled{% endblock %}

{% block content %}
    {% set quick_links = [
        {label: 'Objednávky', url: path('admin_orders'), icon: 'cart', primary: true},
        {label: 'Přidat aktualitu', url: path('admin_actuality_create'), icon: 'plus'},
        {label: 'Přidat výjimku (zavřeno)', url: path('admin_place_closed_day_add'), icon: 'calendar_x'},
        {label: 'Přidat produkt', url: path('admin_product_create'), icon: 'tag'},
        {label: 'Rozkrmená krůťata', url: '/admin/rozkrmena-krutata', icon: 'trending'},
        {label: 'Chlazené krůty', url: '/admin/chlazene-kruty', icon: 'snow'},
    ] %}
    {% set missing_expected = expected_orders|filter(expected => expected.status.value == 'missing') %}
    {% set sync_since = sync.since|date('Y-m-d', false) %}

    <div class="admin-page-header">
        <div class="admin-page-heading">
            <h1 class="admin-page-title">Přehled</h1>
            <p class="admin-page-subtitle">Vítejte v administraci.</p>
        </div>
    </div>

    <h2 class="admin-tiles-heading">Rychlé akce</h2>
    <div class="admin-quick">
        {% for link in quick_links %}
            <a class="admin-quick-link{{ (link.primary ?? false) ? ' is-primary' }}" href="{{ link.url }}">
                <span class="admin-tile-icon">{{ icons.icon(link.icon) }}</span>
                <span>{{ link.label }}</span>
            </a>
        {% endfor %}
    </div>

    <h2 class="admin-tiles-heading">Ke kontrole</h2>
    <div class="admin-dash-attention">
        {{ dashboard.attention('Pohoda', 'send', sync.pohodaOverdue, sync.pohodaUpcoming, path('admin_orders', {missing: 'pohoda', date_from: sync_since})) }}
        {{ dashboard.attention('Boxxi (CoolBalík)', 'box', sync.boxxiOverdue, sync.boxxiUpcoming, path('admin_orders', {missing: 'boxxi', date_from: sync_since})) }}
        <a class="admin-dash-check{{ missing_expected|length > 0 ? ' is-danger' : ' is-ok' }}" href="{{ path('admin_recurring_orders') }}">
            <span class="admin-tile-icon">{{ icons.icon('users') }}</span>
            <span>
                <span class="admin-dash-check-title">Pravidelné objednávky</span>
                {% if missing_expected|length > 0 %}
                    <span class="admin-dash-check-value"><strong>{{ missing_expected|length }}</strong> chybí</span>
                {% else %}
                    <span class="admin-dash-check-value">{{ icons.icon('check') }} vše v pořádku</span>
                {% endif %}
                <span class="admin-dash-check-hint">{{ expected_orders|length }} očekávaných na 7 dní</span>
            </span>
        </a>
    </div>

    <h2 class="admin-tiles-heading">Přijaté objednávky</h2>
    <div class="admin-dash-kpis">
        {{ dashboard.kpi('Dnes', 'oproti stejnému dni minulý týden', kpis.today, kpis.today_previous) }}
        {{ dashboard.kpi('Tento měsíc', 'oproti stejnému období loni', kpis.month, kpis.month_previous) }}
        {{ dashboard.kpi('Letos', 'oproti stejnému období loni', kpis.year, kpis.year_previous) }}
    </div>

    <div class="admin-dash-ops-head">
        <h2 class="admin-tiles-heading mb-0">Expedice</h2>
        <a class="btn btn-sm btn-outline-secondary" href="{{ path('admin_preparation') }}">Co připravit {{ icons.icon('arrow_right') }}</a>
    </div>
    {% set day_url = path('admin_preparation') ~ '?day=' %}
    <div class="admin-dash-days">
        {{ dashboard.day_card('Dnes', today_stats, 'expedice', null, day_url) }}
        {{ dashboard.day_card(next_day_title, next_day_stats, 'expedice', null, day_url) }}
    </div>
    {{ dashboard.strip(days, null, day_url) }}
{% endblock %}
