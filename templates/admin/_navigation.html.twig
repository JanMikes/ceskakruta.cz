{#
    Sidebar navigation: static on ≥ lg, Bootstrap 5.2 responsive offcanvas (`offcanvas-lg`) below.
    Labels of the old admin navbar (docs/admin/PLAN.md §2.18), "Prodej" first as the daily work; the group headings are plain text.
#}
{% import 'admin/_icons.html.twig' as icons %}
{% set current_path = app.request.pathInfo %}
{% set dashboards = [
    {label: 'Přehled', url: path('admin_dashboard'), icon: 'home'},
    {label: 'Co připravit', url: path('admin_preparation'), icon: 'clipboard'},
    {label: 'Pravidelné objednávky', url: path('admin_recurring_orders'), icon: 'repeat'},
    {label: 'Statistiky', url: path('admin_statistics'), icon: 'bar_chart'},
] %}
{% set groups = [
    {heading: 'Prodej', links: [
        {label: 'Objednávky', url: '/admin/objednavky', icon: 'cart'},
        {label: 'Uživatelé', url: '/admin/uzivatele', icon: 'users'},
        {label: 'Prodejny', url: '/admin/prodejny', icon: 'pin'},
    ]},
    {heading: 'Web', links: [
        {label: 'Aktuality', url: '/admin/aktuality', icon: 'bell'},
        {label: 'Rozkrmená krůťata', url: '/admin/rozkrmena-krutata', icon: 'trending'},
        {label: 'Chlazené krůty', url: '/admin/chlazene-kruty', icon: 'snow'},
    ]},
    {heading: 'Produkty', links: [
        {label: 'Maso a výrobky', url: '/admin/produkty', icon: 'tag'},
        {label: 'Doplňkový sortiment', sortiment: true, icon: 'grid'},
    ]},
    {heading: 'Obsah a kontakty', links: [
        {label: 'Texty', url: '/admin/texty', icon: 'text'},
        {label: 'Prodejci', url: '/admin/prodejci', icon: 'briefcase'},
        {label: 'Emaily', url: '/admin/emaily', icon: 'mail'},
    ]},
] %}

<header class="admin-topbar">
    <button class="admin-topbar-toggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#admin-sidebar" aria-controls="admin-sidebar" aria-label="Zobrazit menu">
        {{ icons.icon('menu') }}
    </button>
    <a class="admin-brand" href="{{ path('admin_dashboard') }}">
        <img src="/img/turkey-icon.svg" alt="" width="30" height="30">
        <span class="admin-brand-name">Česká Krůta</span>
    </a>
</header>

<aside class="admin-sidebar offcanvas-lg offcanvas-start" id="admin-sidebar" tabindex="-1" aria-label="Menu administrace">
    <div class="admin-sidebar-header">
        <a class="admin-brand" href="{{ path('admin_dashboard') }}">
            <img src="/img/turkey-icon.svg" alt="" width="34" height="34">
            <span class="admin-brand-name">Česká Krůta<small>Administrace</small></span>
        </a>
        <button type="button" class="btn-close btn-close-white d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#admin-sidebar" aria-label="Zavřít menu"></button>
    </div>

    <nav class="admin-sidebar-nav" aria-label="Hlavní navigace">
        {% for link in dashboards %}
            {% set active = current_path == link.url %}
            <a class="admin-nav-link{{ active ? ' active' }}" href="{{ link.url }}"{% if active %} aria-current="page"{% endif %}>
                {{ icons.icon(link.icon) }}<span>{{ link.label }}</span>
            </a>
        {% endfor %}

        {% for group in groups %}
            <div class="admin-nav-heading">{{ group.heading }}</div>
            {% for link in group.links %}
                {% if link.sortiment ?? false %}
                    {% set sortiment_open = current_path starts with '/admin/sortiment' %}
                    <button class="admin-nav-link admin-nav-toggle{{ sortiment_open ? ' active' : ' collapsed' }}" type="button" data-bs-toggle="collapse" data-bs-target="#admin-nav-sortiment" aria-expanded="{{ sortiment_open ? 'true' : 'false' }}" aria-controls="admin-nav-sortiment">
                        {{ icons.icon(link.icon) }}<span>{{ link.label }}</span>{{ icons.icon('chevron_down', 'admin-nav-chevron') }}
                    </button>
                    <div class="collapse{{ sortiment_open ? ' show' }}" id="admin-nav-sortiment">
                        <div class="admin-nav-sub">
                            {% for category in admin_sortiment_categories() %}
                                {% set category_url = '/admin/sortiment/' ~ category.id %}
                                {% set category_active = current_path == category_url or current_path starts with category_url ~ '/' %}
                                <a class="admin-nav-sublink{{ category_active ? ' active' }}{{ category.active ? '' : ' is-inactive' }}" href="{{ category_url }}"{% if category_active %} aria-current="page"{% endif %}>{{ category.name }}</a>
                            {% endfor %}
                            <a class="admin-nav-sublink admin-nav-sublink-muted{{ current_path == '/admin/sortiment' ? ' active' }}" href="/admin/sortiment">Správa kategorií</a>
                        </div>
                    </div>
                {% else %}
                    {% set active = current_path == link.url or current_path starts with link.url ~ '/' %}
                    <a class="admin-nav-link{{ active ? ' active' }}" href="{{ link.url }}"{% if active %} aria-current="page"{% endif %}>
                        {{ icons.icon(link.icon) }}<span>{{ link.label }}</span>
                    </a>
                {% endif %}
            {% endfor %}
        {% endfor %}
    </nav>

    <nav class="admin-sidebar-account" aria-label="Účet">
        {% set password_active = current_path == path('admin_change_password') %}
        <a class="admin-account-link{{ password_active ? ' active' }}" href="{{ path('admin_change_password') }}" title="Změnit heslo – {{ app.user.email }}">
            <span class="admin-account-avatar" aria-hidden="true">{{ icons.icon('user') }}</span>
            <span class="admin-account-name">{{ app.user.email }}</span>
        </a>
        <a class="admin-account-logout" href="{{ path('admin_logout') }}" title="Odhlásit se">
            {{ icons.icon('logout') }}<span>Odhlásit</span>
        </a>
    </nav>
</aside>
