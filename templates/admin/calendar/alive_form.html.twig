{% extends 'admin/base.html.twig' %}
{% import 'admin/_icons.html.twig' as icons %}

{% set heading = row ? 'Upravit položku tabulky živých krůt' : 'Přidat položku tabulky živých krůt' %}

{% block title %}{{ heading }}{% endblock %}

{% block content %}
    <div class="admin-page-header">
        <div class="admin-page-heading">
            <a class="admin-back" href="{{ path('admin_calendar_alive') }}">{{ icons.icon('arrow_left') }}Živé krůty</a>
            <h1 class="admin-page-title">{{ heading }}{% if row %} <small class="text-muted">{{ row.weekLabel }}</small>{% endif %}</h1>
        </div>
    </div>

    <div class="card admin-form-card">
        <div class="card-body">
            {{ form_start(form) }}
                <div class="row">
                    <div class="col-md-6">{{ form_row(form.product_tp_id) }}</div>
                    <div class="col-md-6 pt-md-4">
                        <div class="admin-checks pt-md-2">
                            {{ form_row(form.farma_doubrava, {label_attr: {class: 'checkbox-switch'}}) }}
                            {{ form_row(form.farma_rychvald, {label_attr: {class: 'checkbox-switch'}}) }}
                        </div>
                    </div>
                    <div class="col-6 col-md-3">{{ form_row(form.week_number) }}</div>
                    <div class="col-6 col-md-3">{{ form_row(form.year) }}</div>
                    <div class="col-6 col-md-3">{{ form_row(form.weight_from) }}</div>
                    <div class="col-6 col-md-3">{{ form_row(form.weight_to) }}</div>
                </div>

                {{ include('admin/_form_buttons.html.twig', {is_edit: row is not null, back_url: path('admin_calendar_alive')}) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
