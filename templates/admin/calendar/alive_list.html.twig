{% extends 'admin/base.html.twig' %}
{% import 'admin/_grid.html.twig' as grid %}

{% block title %}Živé krůty{% endblock %}

{% block content %}
    <div class="admin-page-header">
        <div class="admin-page-heading">
            <h1 class="admin-page-title">Živé krůty</h1>
            <p class="admin-page-subtitle">Týdny prodeje živých krůt podle farem a váhových kategorií.</p>
        </div>
        <div class="admin-page-actions">
            {{ grid.activate_all('calendar_alive', inactive_count) }}
            {{ grid.add_link(path('admin_calendar_alive_create'), 'Přidat') }}
        </div>
    </div>

    <div class="card">
        <div class="admin-table-wrap admin-table-stack">
            <table class="table table-hover align-middle admin-table">
                <thead>
                    <tr>
                        <th>Týden</th>
                        <th>Produkt</th>
                        <th>Farma Doubrava</th>
                        <th>Farma Rychvald</th>
                        <th>Váha</th>
                        <th class="text-end">Akce</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        <tr id="item-{{ row.id }}"{% if not row.active %} class="admin-row-inactive"{% endif %}>
                            <td class="text-nowrap admin-cell-primary">{{ row.weekLabel }}</td>
                            <td data-label="Produkt">{{ row.productName }}</td>
                            <td data-label="Farma Doubrava">{{ include('admin/calendar/_yes_no.html.twig', {value: row.farmaDoubrava}) }}</td>
                            <td data-label="Farma Rychvald">{{ include('admin/calendar/_yes_no.html.twig', {value: row.farmaRychvald}) }}</td>
                            <td class="text-nowrap" data-label="Váha">{{ row.weightLabel }}</td>
                            <td class="admin-cell-actions">
                                <div class="admin-actions">
                                    {{ grid.edit_link(path('admin_calendar_alive_edit', {id: row.id})) }}
                                    {{ grid.row_actions('calendar_alive', {id: row.id, active: row.active}) }}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        {{ grid.empty_row(6, 'Prozatím nebyly přidány žádné záznamy.') }}
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
