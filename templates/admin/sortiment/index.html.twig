{% extends 'admin/base.html.twig' %}
{% import 'admin/_icons.html.twig' as icons %}

{% block title %}Doplňkový sortiment{% endblock %}

{% block content %}
    <div class="admin-page-header">
        <div class="admin-page-heading">
            <h1 class="admin-page-title">Doplňkový sortiment</h1>
            <p class="admin-page-subtitle">Vyberte kategorii:</p>
        </div>
    </div>

    {% if categories is empty %}
        <div class="card">
            <div class="admin-empty">
                <span class="admin-empty-icon">{{ icons.icon('inbox') }}</span>
                <p class="admin-empty-title">Žádné kategorie.</p>
            </div>
        </div>
    {% else %}
        <div class="admin-tiles">
            {% for category in categories %}
                <a class="admin-tile admin-category-tile{{ category.active ? '' : ' is-inactive' }}" href="{{ path('admin_sortiment_category', {categoryId: category.id}) }}">
                    <span class="admin-tile-icon">{{ icons.icon('grid') }}</span>
                    <span>
                        <span class="admin-tile-title">{{ category.name }}</span>
                        {% if not category.active %}<span class="admin-tile-text">Kategorie není aktivní</span>{% endif %}
                    </span>
                </a>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
