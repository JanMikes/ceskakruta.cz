{% extends 'admin/base.html.twig' %}
{% import 'admin/_grid.html.twig' as grid %}
{% import 'admin/_icons.html.twig' as icons %}

{% block title %}Uživatelé{% endblock %}

{% block content %}
    <div class="admin-page-header">
        <div class="admin-page-heading">
            <h1 class="admin-page-title">Uživatelé</h1>
            <p class="admin-page-subtitle">Zákaznické účty, nejnovější registrace nahoře.</p>
        </div>
    </div>

    <div class="card">
        <div class="admin-table-wrap admin-table-stack">
            <table class="table table-hover align-middle admin-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Registrace</th>
                        <th>E-mail</th>
                        <th>Jméno</th>
                        <th class="text-end">Počet objednávek</th>
                        <th>Zakázané produkty</th>
                        <th>Velkoobchod</th>
                        <th class="text-end">Akce</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr id="item-{{ user.id }}">
                            <td class="admin-cell-muted" data-label="ID">{{ user.id }}</td>
                            <td class="text-nowrap admin-cell-muted" data-label="Registrace">{{ user.registeredAt|date('d.m.Y H:i', false) }}</td>
                            <td class="admin-cell-primary admin-cell-email">
                                {{ user.email }}
                                {% if user.isAdmin %}<span class="badge admin-badge-soft ms-1">Administrátor</span>{% endif %}
                            </td>
                            <td data-label="Jméno">{{ user.name }}</td>
                            <td class="text-end" data-label="Počet objednávek">{{ user.ordersCount }}</td>
                            <td class="text-nowrap" data-label="Zakázané produkty">
                                <a class="btn btn-sm btn-light btn-with-icon{{ user.bannedProductsCount > 0 ? ' text-danger' }}" href="{{ path('admin_user_banned_products', {id: user.id}) }}">{{ icons.icon('ban') }}<span>{{ user.bannedProductsCount }} zakázaných</span></a>
                            </td>
                            <td data-label="Velkoobchod">
                                <form method="post" action="{{ path('admin_user_wholesale', {id: user.id}) }}" class="admin-wholesale">
                                    <input type="hidden" name="_token" value="{{ csrf_token('admin-action') }}">
                                    {% if user.allowWholesale %}
                                        <span class="admin-pill is-yes">Povolen</span>
                                        <input type="hidden" name="allow" value="0">
                                        <button type="submit" class="btn btn-sm btn-light admin-btn-danger">Zakázat</button>
                                    {% else %}
                                        <span class="admin-pill is-no">Nepovolen</span>
                                        <input type="hidden" name="allow" value="1">
                                        <button type="submit" class="btn btn-sm btn-light">Povolit</button>
                                    {% endif %}
                                </form>
                            </td>
                            <td class="admin-cell-actions">
                                <div class="admin-actions">
                                    {{ grid.edit_link(path('admin_user_edit', {id: user.id})) }}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        {{ grid.empty_row(8, 'Žádní uživatelé.') }}
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
