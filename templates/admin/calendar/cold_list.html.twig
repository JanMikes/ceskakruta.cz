{% extends 'admin/base.html.twig' %}
{% import 'admin/_grid.html.twig' as grid %}

{% block title %}Chlazené krůty{% endblock %}

{% block content %}
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <h1 class="h3 mb-0 me-auto">Chlazené krůty</h1>
        {{ grid.activate_all('calendar_cold', inactive_count) }}
        <a class="btn btn-primary btn-sm" href="{{ path('admin_calendar_cold_create') }}">Přidat</a>
    </div>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Týden</th>
                        <th>Produkt</th>
                        <th>Váha</th>
                        <th class="text-end">Akce</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        <tr id="item-{{ row.id }}" class="{{ row.active ? '' : 'table-secondary text-muted' }}">
                            <td class="text-nowrap">{{ row.weekLabel }}</td>
                            <td>{{ row.productName }}</td>
                            <td class="text-nowrap">{{ row.weightLabel }}</td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-primary" href="{{ path('admin_calendar_cold_edit', {id: row.id}) }}">Upravit</a>
                                {{ grid.row_actions('calendar_cold', {id: row.id, active: row.active}) }}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4" class="text-muted">Prozatím nebyly přidány žádné záznamy.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
