{% extends 'admin/base.html.twig' %}
{% import 'admin/_grid.html.twig' as grid %}
{% import 'admin/_icons.html.twig' as icons %}

{% block title %}Prodejny{% endblock %}

{% block content %}
    {% set day_names = ['Pondělí', 'Úterý', 'Středa', 'Čtvrtek', 'Pátek', 'Sobota', 'Neděle'] %}

    <div class="admin-page-header">
        <div class="admin-page-heading">
            <h1 class="admin-page-title">Prodejny</h1>
            <p class="admin-page-subtitle">Prodejny, rozvozy a dny, ve které je možné vyzvednutí. Výjimky uzavírají prodej v konkrétní den.</p>
        </div>
        <div class="admin-page-actions">
            {{ grid.add_link(path('admin_place_create'), 'Přidat prodejnu') }}
        </div>
    </div>

    <section class="card admin-section">
        <div class="admin-card-header">
            <h2 class="admin-card-title">{{ icons.icon('calendar_x') }}Zavřeno (výjimky)</h2>
            <div class="admin-card-actions">
                <a class="btn btn-sm btn-outline-primary btn-with-icon" href="{{ path('admin_place_closed_day_add') }}">{{ icons.icon('plus') }}<span>Přidat výjimku</span></a>
            </div>
        </div>
        <div class="admin-table-wrap admin-table-stack">
            <table class="table table-hover align-middle admin-table">
                <thead>
                    <tr>
                        <th>Datum zavřeno</th>
                        <th>Prodejna</th>
                        <th class="text-end">Akce</th>
                    </tr>
                </thead>
                <tbody>
                    {% for closed_day in closed_days %}
                        <tr id="closed-day-{{ closed_day.id }}">
                            <td class="admin-cell-primary text-nowrap">{{ closed_day.date|date('d.m.Y', false) }}</td>
                            <td data-label="Prodejna">
                                {% if closed_day.placeId is null %}
                                    <span class="admin-pill is-danger">Všechny</span>
                                {% else %}
                                    {{ closed_day.placeName }}
                                {% endif %}
                            </td>
                            <td class="admin-cell-actions">
                                <div class="admin-actions">
                                    {{ grid.row_actions('place_closed_day', {id: closed_day.id}) }}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        {{ grid.empty_row(3, 'Žádné výjimky.') }}
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    <section class="card admin-section">
        <div class="admin-card-header">
            <h2 class="admin-card-title">{{ icons.icon('pin') }}Prodejny a rozvozy</h2>
            <div class="admin-card-actions">
                {{ grid.activate_all('place', inactive_count) }}
            </div>
        </div>
        <div class="admin-table-wrap admin-table-stack">
            <table class="table table-hover table-sm align-middle admin-table admin-places-table">
                <thead>
                    <tr>
                        <th>Název</th>
                        <th>Rozvoz</th>
                        {% for day_name in day_names %}
                            <th>{{ day_name }}</th>
                        {% endfor %}
                        <th class="text-end">Akce</th>
                    </tr>
                </thead>
                <tbody>
                    {% for place in places %}
                        <tr id="item-{{ place.id }}"{% if not place.active %} class="admin-row-inactive"{% endif %}>
                            <td class="admin-cell-primary">{{ place.name }}</td>
                            <td class="text-nowrap" data-label="Rozvoz">
                                {{ place.forceDeliveryAddress ? 'Ano' : 'Ne' }}
                                {% if place.isCoolBalik %}<br><span class="admin-pill is-info"><span class="visually-hidden">(</span>Cool balík<span class="visually-hidden">)</span></span>{% endif %}
                            </td>
                            {% for day in place.days %}
                                <td class="admin-day-cell{{ day.enabled ? ' is-enabled' }}" data-label="{{ day.dayName }}">
                                    {% if day.enabled %}
                                        <span class="admin-day-state">Povoleno</span><br>
                                        Dnů před: {{ day.daysBefore }}<br>
                                        <span class="admin-day-close">({{ day.orderDayName }} {{ day.time }})</span>
                                    {% else %}
                                        <span class="admin-day-off">-</span>
                                    {% endif %}
                                </td>
                            {% endfor %}
                            <td class="admin-cell-actions">
                                <div class="admin-actions">
                                    {{ grid.edit_link(path('admin_place_edit', {id: place.id})) }}
                                    {{ grid.row_actions('place', {id: place.id, active: place.active}, {first: loop.first, last: loop.last}) }}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        {{ grid.empty_row(10, 'Žádné prodejny.') }}
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
