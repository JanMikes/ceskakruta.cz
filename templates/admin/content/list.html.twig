{% extends 'admin/base.html.twig' %}

{% block title %}Texty{% endblock %}

{% block content %}
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <h1 class="h3 mb-0 me-auto">Texty</h1>
    </div>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Sekce</th>
                        <th class="text-end">Akce</th>
                    </tr>
                </thead>
                <tbody>
                    {% for content in contents %}
                        <tr id="item-{{ content.id }}">
                            <td>{{ content.name }}</td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-primary" href="{{ path('admin_content_edit', {id: content.id}) }}">Upravit</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="2" class="text-muted">Žádné texty.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
