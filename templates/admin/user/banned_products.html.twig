{% extends 'admin/base.html.twig' %}
{% import 'admin/_icons.html.twig' as icons %}

{% block title %}Zakázané produkty{% endblock %}

{% block content %}
    <div class="admin-page-header">
        <div class="admin-page-heading">
            <a class="admin-back" href="{{ path('admin_users') }}">{{ icons.icon('arrow_left') }}Uživatelé</a>
            <h1 class="admin-page-title">Zakázané produkty <small class="text-muted">{{ user.email }}</small></h1>
        </div>
    </div>

    <div class="card admin-form-card">
        <div class="card-body">
            {{ form_start(form) }}
                <p class="admin-form-section-hint mt-0">Zaškrtnuté produkty uživatel nemůže objednat.</p>
                <div class="admin-check-grid">
                    {% for checkbox in form.products %}
                        <div>{{ form_widget(checkbox) }}</div>
                    {% endfor %}
                </div>
                {% do form.products.setRendered %}

                {{ include('admin/_form_buttons.html.twig', {back_url: path('admin_users')}) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
