{% extends 'admin/base.html.twig' %}
{% import 'admin/_grid.html.twig' as grid %}
{% import 'admin/_icons.html.twig' as icons %}

{% block title %}Uživatelé{% endblock %}

{% block content %}
    {% set query = filter.toQuery %}
    {% set filter_active = filter.search is not null or filter.wholesale is not null %}

    <div class="admin-page-header">
        <div class="admin-page-heading">
            <h1 class="admin-page-title">Uživatelé</h1>
            <p class="admin-page-subtitle">Zákaznické účty, nejnovější registrace nahoře. <span class="admin-count">Celkem {{ total }}</span></p>
        </div>
    </div>

    <button class="btn btn-light btn-with-icon w-100 admin-filter-toggle d-md-none{{ filter_active ? '' : ' collapsed' }}" type="button" data-bs-toggle="collapse" data-bs-target="#admin-user-filter" aria-expanded="{{ filter_active ? 'true' : 'false' }}" aria-controls="admin-user-filter">
        {{ icons.icon('filter') }}<span>Filtry{% if filter_active %} (aktivní){% endif %}</span>
    </button>

    <form method="get" action="{{ path('admin_users') }}" class="card admin-filter collapse d-md-block{{ filter_active ? ' show' }}" id="admin-user-filter">
        <div class="card-body">
            <div class="row g-2 g-md-3 align-items-end">
                <div class="col-12 col-md-6 col-lg-5">
                    <label class="form-label" for="filter-search">Hledat</label>
                    <input class="form-control" type="search" id="filter-search" name="search" value="{{ filter.search }}" placeholder="E-mail, jméno, telefon nebo firma" autocomplete="off">
                </div>
                <div class="col-12 col-md-6 col-lg-3">
                    <label class="form-label" for="filter-wholesale">Velkoobchod</label>
                    <select class="form-select" id="filter-wholesale" name="wholesale">
                        <option value=""{{ filter.wholesale is null ? ' selected' }}>Všichni</option>
                        <option value="1"{{ filter.wholesale is same as(true) ? ' selected' }}>Povolen</option>
                        <option value="0"{{ filter.wholesale is same as(false) ? ' selected' }}>Nepovolen</option>
                    </select>
                </div>
                <div class="col-12 col-lg-4 d-flex flex-wrap gap-2">
                    <button class="btn btn-primary btn-with-icon flex-grow-1 flex-md-grow-0" type="submit">{{ icons.icon('filter') }}<span>Filtrovat</span></button>
                    <a class="btn btn-link text-muted" href="{{ path('admin_users') }}">Resetovat</a>
                </div>
            </div>
        </div>
    </form>

    <div class="card">
        <div class="admin-table-wrap admin-table-stack">
            <table class="table table-hover align-middle admin-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Registrace</th>
                        <th>E-mail</th>
                        <th>Jméno</th>
                        <th class="text-end">Počet objednávek</th>
                        <th>Zakázané produkty</th>
                        <th>Velkoobchod</th>
                        <th class="text-end">Akce</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr id="item-{{ user.id }}">
                            <td class="admin-cell-muted" data-label="ID">{{ user.id }}</td>
                            <td class="text-nowrap admin-cell-muted" data-label="Registrace">{{ user.registeredAt|date('d.m.Y H:i', false) }}</td>
                            <td class="admin-cell-primary admin-cell-email">
                                {{ user.email }}
                                {% if user.isAdmin %}<span class="badge admin-badge-soft ms-1">Administrátor</span>{% endif %}
                            </td>
                            <td data-label="Jméno">{{ user.name }}</td>
                            <td class="text-end" data-label="Počet objednávek">{{ user.ordersCount }}</td>
                            <td class="text-nowrap" data-label="Zakázané produkty">
                                <a class="btn btn-sm btn-light btn-with-icon{{ user.bannedProductsCount > 0 ? ' text-danger' }}" href="{{ path('admin_user_banned_products', {id: user.id}) }}">{{ icons.icon('ban') }}<span>{{ user.bannedProductsCount }} zakázaných</span></a>
                            </td>
                            <td data-label="Velkoobchod">
                                <form method="post" action="{{ path('admin_user_wholesale', {id: user.id}) }}" class="admin-wholesale">
                                    <input type="hidden" name="_token" value="{{ csrf_token('admin-action') }}">
                                    <input type="hidden" name="_target" value="{{ app.request.requestUri }}">
                                    {% if user.allowWholesale %}
                                        <span class="admin-pill is-yes">Povolen</span>
                                        <input type="hidden" name="allow" value="0">
                                        <button type="submit" class="btn btn-sm btn-light admin-btn-danger">Zakázat</button>
                                    {% else %}
                                        <span class="admin-pill is-no">Nepovolen</span>
                                        <input type="hidden" name="allow" value="1">
                                        <button type="submit" class="btn btn-sm btn-light">Povolit</button>
                                    {% endif %}
                                </form>
                            </td>
                            <td class="admin-cell-actions">
                                <div class="admin-actions">
                                    {{ grid.edit_link(path('admin_user_edit', {id: user.id})) }}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        {{ grid.empty_row(8, filter_active ? 'Filtru neodpovídá žádný uživatel.' : 'Žádní uživatelé.') }}
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {% include 'admin/_pagination.html.twig' with {route: 'admin_users', query: query, page: page, pages: pages} only %}
{% endblock %}
