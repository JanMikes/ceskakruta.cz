{% extends 'admin/base.html.twig' %}
{% import 'admin/_icons.html.twig' as icons %}

{% set heading = row ? 'Upravit položku tabulky rozkrmených krůťat' : 'Přidat položku tabulky rozkrmených krůťat' %}

{% block title %}{{ heading }}{% endblock %}

{% block content %}
    <div class="admin-page-header">
        <div class="admin-page-heading">
            <a class="admin-back" href="{{ path('admin_calendar_dead') }}">{{ icons.icon('arrow_left') }}Rozkrmená krůťata</a>
            <h1 class="admin-page-title">{{ heading }}{% if row %} <small class="text-muted">{{ row.weekLabel }}</small>{% endif %}</h1>
        </div>
    </div>

    <div class="card admin-form-card">
        <div class="card-body">
            {{ form_start(form) }}
                <div class="admin-form-section">
                    <h2 class="admin-form-section-title">Termín a farmy</h2>
                    <div class="row">
                        <div class="col-6 col-md-3">{{ form_row(form.week_number) }}</div>
                        <div class="col-6 col-md-3">{{ form_row(form.year) }}</div>
                        <div class="col-6 col-md-3">{{ form_row(form.week_age) }}</div>
                    </div>
                    <div class="admin-checks">
                        {{ form_row(form.farma_doubrava, {label_attr: {class: 'checkbox-switch'}}) }}
                        {{ form_row(form.farma_rychvald, {label_attr: {class: 'checkbox-switch'}}) }}
                    </div>
                </div>

                <div class="admin-form-section">
                    <h2 class="admin-form-section-title">Váha a ceny</h2>
                    <div class="row">
                        <div class="col-6 col-md-3">{{ form_row(form.weight) }}</div>
                        <div class="col-6 col-md-3">{{ form_row(form.price_mix) }}</div>
                        <div class="col-6 col-md-3">{{ form_row(form.price_man) }}</div>
                        <div class="col-6 col-md-3">{{ form_row(form.price_woman) }}</div>
                        <div class="col-md-6">{{ form_row(form.note) }}</div>
                    </div>
                </div>

                {{ include('admin/_form_buttons.html.twig', {is_edit: row is not null, back_url: path('admin_calendar_dead')}) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
