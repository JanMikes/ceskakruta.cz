{% extends 'admin/base.html.twig' %}
{% import 'admin/_icons.html.twig' as icons %}

{% set heading = place ? 'Upravit prodejnu' : 'Přidat prodejnu' %}

{% block title %}{{ heading }}{% endblock %}

{% block content %}
    <div class="admin-page-header">
        <div class="admin-page-heading">
            <a class="admin-back" href="{{ path('admin_places') }}">{{ icons.icon('arrow_left') }}Prodejny</a>
            <h1 class="admin-page-title">{{ heading }}{% if place %} <small class="text-muted">{{ place.name }}</small>{% endif %}</h1>
        </div>
    </div>

    <div class="card admin-form-card">
        <div class="card-body">
            {{ form_start(form) }}
                <div class="admin-form-section">
                    <h2 class="admin-form-section-title">Základní údaje</h2>
                    {% if form.prices_from_place_id is defined %}
                        <div class="row">
                            <div class="col-md-6">{{ form_row(form.prices_from_place_id) }}</div>
                        </div>
                    {% endif %}

                    <div class="row">
                        <div class="col-md-6">{{ form_row(form.name) }}</div>
                        <div class="col-md-6">{{ form_row(form.title) }}</div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            {{ form_row(form.allow_only_wholesale, {label_attr: {class: 'checkbox-switch'}}) }}
                            {{ form_row(form.force_delivery_address, {label_attr: {class: 'checkbox-switch'}}) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.is_cool_balik, {label_attr: {class: 'checkbox-switch'}}) }}
                            {{ form_row(form.force_packing, {label_attr: {class: 'checkbox-switch'}}) }}
                        </div>
                    </div>
                </div>

                <div class="admin-form-section">
                    <h2 class="admin-form-section-title">Dny prodeje</h2>
                    <p class="admin-form-section-hint">Zapněte dny, kdy je možné objednávku vyzvednout, a nastavte, kolik dní předem a do kolika hodin se musí objednat.</p>
                    <div class="row g-3">
                        {% for day in 1..7 %}
                            <div class="col-sm-6 col-xl-3" data-controller="admin--place-day" data-admin--place-day-day-value="{{ day }}">
                                <div class="admin-day">
                                    {{ form_row(form['enable_day_' ~ day], {label_attr: {class: 'checkbox-switch fw-semibold'}, attr: {'data-admin--place-day-target': 'enable', 'data-action': 'admin--place-day#toggle'}}) }}
                                    <div data-admin--place-day-target="inputs">
                                        {{ form_row(form['allow_order_day_' ~ day ~ '_days_before'], {
                                            attr: {'data-admin--place-day-target': 'daysBefore', 'data-action': 'input->admin--place-day#update', inputmode: 'numeric'},
                                            help: '<span data-admin--place-day-target="hint"></span>',
                                            help_html: true,
                                        }) }}
                                        {{ form_row(form['allow_order_day_' ~ day ~ '_time'], {
                                            attr: {'data-admin--place-day-target': 'time', 'data-action': 'input->admin--place-day#validateTime', placeholder: 'HH:MM'},
                                        }) }}
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                <div class="admin-form-section">
                    <h2 class="admin-form-section-title">Popis a otevírací doba</h2>
                    {{ form_row(form.description) }}

                    <div class="row">
                        <div class="col-md-6">{{ form_row(form.opening_hours) }}</div>
                        <div class="col-md-6">{{ form_row(form.opening_hours_email) }}</div>
                    </div>
                </div>

                {{ include('admin/_form_buttons.html.twig', {is_edit: place is not null, back_url: path('admin_places')}) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
