{% set order = record.order %}
<section class="card mb-3">
    <div class="admin-card-header">
        <h2 class="admin-card-title">Souhrn</h2>
    </div>
    <table class="table admin-detail">
        <tbody>
            <tr>
                <th>Č.:</th>
                <td>
                    <strong>{{ order.id }}</strong>
                    {% if record.source is not null %} <span class="badge admin-badge-soft">Nový web</span>{% endif %}
                </td>
            </tr>
            <tr><th>Datum provedení:</th><td>{{ order.insertedAt|date('d.m.Y H:i', false) }}</td></tr>
            <tr>
                <th>Zákazník:</th>
                <td>
                    <strong>{{ order.name }}</strong><br>
                    {% if order.phone %}<a href="tel:{{ order.phone|replace({' ': ''}) }}">{{ order.phone }}</a>{% endif %}<br>
                    {% if order.email %}<a href="mailto:{{ order.email }}">{{ order.email }}</a>{% endif %}<br>
                    {{ order.deliveryStreet }}<br>
                    {{ order.deliveryCity }} {{ order.deliveryPostalCode }}
                </td>
            </tr>
            <tr>
                <th>Sleva:</th>
                <td>
                    {% if order.couponPercentValue %}
                        {{ record.couponCode }} <span class="admin-pill is-primary">-{{ order.couponPercentValue }}%</span>
                    {% else %}
                        -
                    {% endif %}
                </td>
            </tr>
            <tr><th>Cena celkem:</th><td><strong>{{ record.priceTotal|number_format(0, '', '.') }} Kč</strong></td></tr>
            <tr><th>Platba kartou:</th><td>{{ order.payByCard ? 'Ano' : 'Ne' }}</td></tr>
            <tr><th>Místo:</th><td>{{ order.place.name }}</td></tr>
            <tr><th>Datum:</th><td>{{ order.date|date('d.m.Y', false) }}</td></tr>
            <tr><th>Poznámka:</th><td>{{ order.note }}</td></tr>
        </tbody>
    </table>
</section>
