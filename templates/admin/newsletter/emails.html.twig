{% extends 'admin/base.html.twig' %}
{% import 'admin/_grid.html.twig' as grid %}

{% block title %}Emaily{% endblock %}

{% block content %}
    <div class="admin-page-header">
        <div class="admin-page-heading">
            <h1 class="admin-page-title">Emaily</h1>
            <p class="admin-page-subtitle">Odběratelé novinek, nejnovější nahoře. <span class="admin-count">Celkem {{ total }}</span></p>
        </div>
    </div>

    <div class="card">
        <div class="admin-table-wrap admin-table-stack">
            <table class="table table-hover align-middle admin-table">
                <thead>
                    <tr>
                        <th>Email</th>
                        <th>Přidáno</th>
                        <th class="text-end">Akce</th>
                    </tr>
                </thead>
                <tbody>
                    {% for email in emails %}
                        <tr id="item-{{ email.id }}">
                            <td class="admin-cell-primary admin-cell-email">{{ email.email }}</td>
                            <td class="text-nowrap admin-cell-muted" data-label="Přidáno">{{ email.insertedAt|date('d.m.Y H:i:s', false) }}</td>
                            <td class="admin-cell-actions">
                                <div class="admin-actions">
                                    {{ grid.row_actions('newsletter', {id: email.id}) }}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        {{ grid.empty_row(3, 'Prozatím nebyly přidány žádné záznamy.') }}
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {% include 'admin/_pagination.html.twig' with {route: 'admin_newsletter_emails', page: page, pages: pages} only %}
{% endblock %}
