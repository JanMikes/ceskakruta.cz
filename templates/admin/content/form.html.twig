{% extends 'admin/base.html.twig' %}
{% import 'admin/_icons.html.twig' as icons %}

{% block title %}Upravit text{% endblock %}

{% block content %}
    <div class="admin-page-header">
        <div class="admin-page-heading">
            <a class="admin-back" href="{{ path('admin_contents') }}">{{ icons.icon('arrow_left') }}Texty</a>
            <h1 class="admin-page-title">Upravit text{% if content.name %} <small class="text-muted">{{ content.name }}</small>{% endif %}</h1>
        </div>
    </div>

    <div class="card admin-form-card">
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_row(form.text) }}

                {{ include('admin/_form_buttons.html.twig', {is_edit: true, back_url: path('admin_contents')}) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
