{% extends 'admin/base.html.twig' %}
{% import 'admin/_icons.html.twig' as icons %}

{% set heading = product ? 'Upravit produkt' : 'Přidat produkt' %}

{% block title %}{{ heading }}{% endblock %}

{% block content %}
    <div class="admin-page-header">
        <div class="admin-page-heading">
            <a class="admin-back" href="{{ path('admin_products') }}">{{ icons.icon('arrow_left') }}Maso a výrobky</a>
            <h1 class="admin-page-title">{{ heading }}{% if product and product.name %} <small class="text-muted">{{ product.name }}</small>{% endif %}</h1>
        </div>
    </div>

    <div class="card admin-form-card">
        <div class="card-body">
            {{ form_start(form) }}
                {% if product and product.turkey %}
                    <div class="alert alert-info d-flex align-items-start gap-2 py-2">
                        {{ icons.icon('info', 'mt-1') }}
                        <span>U krůt lze upravit pouze cenu, kód produktu a popis.</span>
                    </div>

                    <div class="row">
                        <div class="col-6 col-md-3">{{ form_row(form.price) }}</div>
                        <div class="col-6 col-md-3">{{ form_row(form.code) }}</div>
                    </div>
                    {{ form_row(form.text) }}
                {% else %}
                    <div class="admin-form-section">
                        <h2 class="admin-form-section-title">Základní údaje</h2>
                        <div class="row">
                            <div class="col-md-6">{{ form_row(form.name) }}</div>
                            <div class="col-6 col-md-3">{{ form_row(form.type) }}</div>
                            <div class="col-6 col-md-3">{{ form_row(form.unit) }}</div>
                            <div class="col-6 col-md-3">{{ form_row(form.weight_per_unit) }}</div>
                            <div class="col-6 col-md-3">{{ form_row(form.price) }}</div>
                            <div class="col-6 col-md-3">{{ form_row(form.code) }}</div>
                            <div class="col-6 col-md-3">{{ form_row(form.packages_size) }}</div>
                        </div>
                    </div>

                    <div class="admin-form-section" data-controller="admin--checkbox-toggle">
                        <h2 class="admin-form-section-title">Krájení a balení</h2>
                        <div class="admin-checks">
                            {{ form_row(form.can_be_sliced_flag, {label_attr: {class: 'checkbox-switch'}}) }}
                            {{ form_row(form.can_be_packed_flag, {label_attr: {class: 'checkbox-switch'}, attr: {
                                'data-admin--checkbox-toggle-target': 'checkbox',
                                'data-action': 'change->admin--checkbox-toggle#toggle',
                            }}) }}
                        </div>
                        <div class="row align-items-end" data-admin--checkbox-toggle-target="content">
                            <div class="col-6 col-md-3">{{ form_row(form.force_packing, {label_attr: {class: 'checkbox-switch'}}) }}</div>
                            <div class="col-6 col-md-3">{{ form_row(form.price_pack) }}</div>
                        </div>
                    </div>

                    <div class="admin-form-section">
                        <h2 class="admin-form-section-title">Popis</h2>
                        {{ form_row(form.text_additional) }}
                        {{ form_row(form.text) }}
                    </div>
                {% endif %}

                {{ include('admin/_form_buttons.html.twig', {is_edit: product is not null, back_url: path('admin_products')}) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
