{% extends 'admin/base.html.twig' %}
{% import 'admin/_grid.html.twig' as grid %}

{% block title %}Prodejci{% endblock %}

{% block content %}
    <div class="admin-page-header">
        <div class="admin-page-heading">
            <h1 class="admin-page-title">Prodejci</h1>
            <p class="admin-page-subtitle">Prodejci produktů České Krůty zobrazení na webu.</p>
        </div>
        <div class="admin-page-actions">
            {{ grid.activate_all('vendor', inactive_count) }}
            {{ grid.add_link(path('admin_vendor_create'), 'Přidat prodejce') }}
        </div>
    </div>

    <div class="card">
        <div class="admin-table-wrap admin-table-stack">
            <table class="table table-hover align-middle admin-table">
                <thead>
                    <tr>
                        <th>Název prodejce</th>
                        <th>Město</th>
                        <th class="text-end">Akce</th>
                    </tr>
                </thead>
                <tbody>
                    {% for vendor in vendors %}
                        <tr id="item-{{ vendor.id }}"{% if not vendor.active %} class="admin-row-inactive"{% endif %}>
                            <td class="admin-cell-primary">{{ vendor.name }}</td>
                            <td data-label="Město">{{ vendor.city }}</td>
                            <td class="admin-cell-actions">
                                <div class="admin-actions">
                                    {{ grid.edit_link(path('admin_vendor_edit', {id: vendor.id})) }}
                                    {{ grid.row_actions('vendor', {id: vendor.id, active: vendor.active}, {first: loop.first, last: loop.last}) }}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        {{ grid.empty_row(3, 'Žádní prodejci.') }}
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
