{# Usage: {% include 'admin/_pagination.html.twig' with {route: 'admin_orders', query: {...}, page: page, pages: pages} only %} #}
{% if pages > 1 %}
    {% set query = query ?? {} %}
    {% set window = range(max(1, page - 3), min(pages, page + 3)) %}
    <nav class="admin-pagination" aria-label="Stránkování">
        <span class="admin-pagination-info">Strana {{ page }} z {{ pages }}</span>
        <ul class="pagination mb-0">
            <li class="page-item{{ page == 1 ? ' disabled' }}">
                <a class="page-link" href="{{ path(route, query|merge({page: max(1, page - 1)})) }}" aria-label="Předchozí"{% if page == 1 %} tabindex="-1" aria-disabled="true"{% endif %}>&lsaquo;</a>
            </li>
            {% if window|first > 1 %}
                <li class="page-item"><a class="page-link" href="{{ path(route, query|merge({page: 1})) }}">1</a></li>
                {% if window|first > 2 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
            {% endif %}
            {% for number in window %}
                <li class="page-item{{ number == page ? ' active' }}"{% if number == page %} aria-current="page"{% endif %}>
                    <a class="page-link" href="{{ path(route, query|merge({page: number})) }}">{{ number }}</a>
                </li>
            {% endfor %}
            {% if window|last < pages %}
                {% if window|last < pages - 1 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
                <li class="page-item"><a class="page-link" href="{{ path(route, query|merge({page: pages})) }}">{{ pages }}</a></li>
            {% endif %}
            <li class="page-item{{ page == pages ? ' disabled' }}">
                <a class="page-link" href="{{ path(route, query|merge({page: min(pages, page + 1)})) }}" aria-label="Další"{% if page == pages %} tabindex="-1" aria-disabled="true"{% endif %}>&rsaquo;</a>
            </li>
        </ul>
    </nav>
{% endif %}
