{% extends 'admin/base.html.twig' %}

{% set heading = actuality ? 'Upravit aktualitu' : 'Přidat aktualitu' %}

{% block title %}{{ heading }}{% endblock %}

{% block content %}
    <h1 class="h3 mb-4">{{ heading }}{% if actuality and actuality.name %} <small class="text-muted">{{ actuality.name }}</small>{% endif %}</h1>

    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
                <div class="row">
                    <div class="col-md-3">{{ form_row(form.date) }}</div>
                    <div class="col-md-9">{{ form_row(form.name) }}</div>
                </div>
                {% if not actuality %}
                    <p class="form-text mt-0">Po uložení bude aktualita rozeslána e-mailem všem odběratelům novinek.</p>
                {% endif %}
                {{ form_row(form.text) }}
                {{ form_row(form.text_full) }}

                {{ include('admin/_form_buttons.html.twig', {is_edit: actuality is not null, back_url: path('admin_actualities')}) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
