{% extends 'admin/base.html.twig' %}
{% import 'admin/_grid.html.twig' as grid %}

{% block title %}Aktuality{% endblock %}

{% block content %}
    <div class="admin-page-header">
        <div class="admin-page-heading">
            <h1 class="admin-page-title">Aktuality</h1>
            <p class="admin-page-subtitle">Novinky na webu. Nová aktualita se po uložení rozešle odběratelům novinek.</p>
        </div>
        <div class="admin-page-actions">
            {{ grid.activate_all('actuality', inactive_count) }}
            {{ grid.add_link(path('admin_actuality_create'), 'Přidat aktualitu') }}
        </div>
    </div>

    <div class="card">
        <div class="admin-table-wrap admin-table-stack">
            <table class="table table-hover align-middle admin-table">
                <thead>
                    <tr>
                        <th>Datum</th>
                        <th>Nadpis</th>
                        <th class="text-end">Akce</th>
                    </tr>
                </thead>
                <tbody>
                    {% for actuality in actualities %}
                        <tr id="item-{{ actuality.id }}"{% if not actuality.active %} class="admin-row-inactive"{% endif %}>
                            <td class="text-nowrap" data-label="Datum">{{ actuality.date ? actuality.date|date('d.m.Y', false) }}</td>
                            <td class="admin-cell-primary">{{ actuality.name }}</td>
                            <td class="admin-cell-actions">
                                <div class="admin-actions">
                                    {{ grid.edit_link(path('admin_actuality_edit', {id: actuality.id})) }}
                                    {{ grid.row_actions('actuality', {id: actuality.id, active: actuality.active}) }}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        {{ grid.empty_row(3, 'Žádné aktuality.', 'Přidejte první aktualitu tlačítkem „Přidat aktualitu“.') }}
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
