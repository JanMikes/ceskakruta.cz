{% extends 'admin/base.html.twig' %}
{% import 'admin/_icons.html.twig' as icons %}

{% block title %}Změna hesla{% endblock %}

{% block content %}
    <div class="admin-page-header">
        <div class="admin-page-heading">
            <h1 class="admin-page-title">Změna hesla</h1>
            <p class="admin-page-subtitle">Nové heslo musí mít 4 až 20 znaků.</p>
        </div>
    </div>

    <div class="card admin-form-card admin-form-card-narrow">
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_row(form.old_password) }}
                {{ form_row(form.new_password.first) }}
                {{ form_row(form.new_password.second) }}

                <div class="admin-form-actions">
                    <button class="btn btn-primary btn-with-icon" type="submit">{{ icons.icon('lock') }}<span>Uložit</span></button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
