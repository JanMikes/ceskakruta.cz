{# items: list<AdminOrderDetailItem>, weight_hint: "{weight_per_unit} kg/ks" for ks products without turkey weights #}
<div class="card mb-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Položka</th>
                    <th>Cena j.</th>
                    <th>Počet</th>
                    <th>Váha</th>
                    <th class="text-end">Cena celkem</th>
                </tr>
            </thead>
            <tbody>
                {% for row in items %}
                    {% set item = row.item %}
                    <tr>
                        <td>{{ item.productName }}</td>
                        <td class="text-nowrap">{{ item.pricePerUnit }} Kč / {{ item.weightFrom is not null ? 'kg' : item.productUnit }}</td>
                        <td class="text-nowrap">
                            {{ item.amount }} {{ item.productUnit }}
                            {% if (weight_hint ?? false) and item.weightFrom is null and item.productUnit == 'ks' %}
                                <br><small class="text-muted">{{ item.productWeightPerUnit }} kg/ks</small>
                            {% endif %}
                        </td>
                        <td class="text-nowrap">{{ item.weightFrom is not null ? item.weightFrom ~ ' - ' ~ item.weightTo ~ ' kg' : '–' }}</td>
                        <td class="text-end text-nowrap">{{ row.priceTotal|number_format(0, '', '.') }} Kč</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
