{% extends 'admin/base.html.twig' %}
{% import 'admin/_grid.html.twig' as grid %}

{% block title %}Doplňkový sortiment – {{ category.name }}{% endblock %}

{% block content %}
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <h1 class="h3 mb-0 me-auto">Doplňkový sortiment <small class="text-muted">{{ category.name }}</small></h1>
        {{ grid.activate_all('sortiment', inactive_count, {scope: category.id}) }}
        <a class="btn btn-primary btn-sm" href="{{ path('admin_sortiment_create', {categoryId: category.id}) }}">Přidat sortiment</a>
    </div>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Název</th>
                        <th class="text-end">Akce</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in items %}
                        <tr id="item-{{ item.id }}" class="{{ item.active ? '' : 'table-secondary text-muted' }}">
                            <td>{{ item.name }}</td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-primary" href="{{ path('admin_sortiment_edit', {categoryId: category.id, id: item.id}) }}">Upravit</a>
                                {# Old SortimentList: the first 3 rows have no up arrow #}
                                {{ grid.row_actions('sortiment', {id: item.id, active: item.active}, {last: loop.last, hide_move_up: loop.index <= 3}) }}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="2" class="text-muted">Žádné položky.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
