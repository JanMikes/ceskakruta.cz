{% extends 'admin/base.html.twig' %}

{% block title %}Upravit text{% endblock %}

{% block content %}
    <h1 class="h3 mb-4">Upravit text{% if content.name %} <small class="text-muted">{{ content.name }}</small>{% endif %}</h1>

    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_row(form.text) }}

                {{ include('admin/_form_buttons.html.twig', {is_edit: true, back_url: path('admin_contents')}) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
