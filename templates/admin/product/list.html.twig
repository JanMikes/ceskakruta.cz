{% extends 'admin/base.html.twig' %}
{% import 'admin/_grid.html.twig' as grid %}
{% import 'admin/_icons.html.twig' as icons %}

{% block title %}Maso a výrobky{% endblock %}

{% block content %}
    <div class="admin-page-header">
        <div class="admin-page-heading">
            <h1 class="admin-page-title">Maso a výrobky</h1>
            <p class="admin-page-subtitle">Produkty e-shopu v pořadí, v jakém se zobrazují na webu.</p>
        </div>
        <div class="admin-page-actions">
            {{ grid.activate_all('product', inactive_count) }}
            {{ grid.add_link(path('admin_product_create'), 'Přidat produkt') }}
        </div>
    </div>

    <div class="card">
        <div class="admin-table-wrap admin-table-stack">
            <table class="table table-hover align-middle admin-table">
                <thead>
                    <tr>
                        <th>Název</th>
                        <th class="text-end">Cena/kg</th>
                        <th>Recepty</th>
                        <th class="text-end">Akce</th>
                    </tr>
                </thead>
                <tbody>
                    {% for product in products %}
                        <tr id="item-{{ product.id }}"{% if not product.active %} class="admin-row-inactive"{% endif %}>
                            <td class="admin-cell-primary">
                                {{ product.name }}
                                {% if product.turkey %}<span class="admin-pill is-primary ms-1">krůta</span>{% endif %}
                            </td>
                            <td class="text-end text-nowrap" data-label="Cena/kg">{% if product.price is not null %}{{ product.price }} Kč{% endif %}</td>
                            <td data-label="Recepty">
                                <a class="btn btn-sm btn-light btn-with-icon text-nowrap" href="{{ path('admin_recipes', {productId: product.id}) }}">{{ icons.icon('book') }}<span>Recepty ({{ product.recipesCount }})</span></a>
                            </td>
                            <td class="admin-cell-actions">
                                <div class="admin-actions">
                                    {{ grid.edit_link(path('admin_product_edit', {id: product.id})) }}
                                    {{ grid.row_actions('product', {id: product.id, active: product.active, type: product.type}, {first: loop.first, last: loop.last}) }}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        {{ grid.empty_row(4, 'Žádné produkty.') }}
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
