{% extends 'admin/base.html.twig' %}
{% import 'admin/_icons.html.twig' as icons %}

{% set heading = row ? 'Upravit položku tabulky chlazených krůt' : 'Přidat položku tabulky chlazených krůt' %}

{% block title %}{{ heading }}{% endblock %}

{% block content %}
    <div class="admin-page-header">
        <div class="admin-page-heading">
            <a class="admin-back" href="{{ path('admin_calendar_cold') }}">{{ icons.icon('arrow_left') }}Chlazené krůty</a>
            <h1 class="admin-page-title">{{ heading }}{% if row %} <small class="text-muted">{{ row.weekLabel }}</small>{% endif %}</h1>
        </div>
    </div>

    <div class="card admin-form-card">
        <div class="card-body">
            {{ form_start(form) }}
                <div class="row">
                    <div class="col-md-6">{{ form_row(form.product_tp_id) }}</div>
                    <div class="col-6 col-md-3">{{ form_row(form.week_number) }}</div>
                    <div class="col-6 col-md-3">{{ form_row(form.year) }}</div>
                    <div class="col-6 col-md-3">{{ form_row(form.weight_from) }}</div>
                    <div class="col-6 col-md-3">{{ form_row(form.weight_to) }}</div>
                </div>

                {{ include('admin/_form_buttons.html.twig', {is_edit: row is not null, back_url: path('admin_calendar_cold')}) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
