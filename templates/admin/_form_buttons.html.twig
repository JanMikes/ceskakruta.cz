{# Submit buttons of every admin form (docs/admin/PLAN.md §4.6), `is_edit` adds "save and continue" #}
<div class="d-flex flex-wrap gap-2 mt-4">
    <button class="btn btn-primary" type="submit">Uložit</button>
    {% if is_edit ?? false %}
        <button class="btn btn-outline-primary" type="submit" name="_continue" value="1">Uložit a pokračovat v editaci</button>
    {% endif %}
    {% if back_url is defined %}
        <a class="btn btn-link" href="{{ back_url }}">Zpět na seznam</a>
    {% endif %}
</div>
