{#
    Dashboard building blocks: {% import 'admin/_dashboard.html.twig' as dashboard %}
#}

{% macro weekday(date) -%}
    {{- ['Po', 'Út', 'St', 'Čt', 'Pá', 'So', 'Ne'][date|date('N', false) - 1] -}}
{%- endmacro %}

{% macro money(value) -%}
    {{- value|number_format(0, '', '.') }} Kč
{%- endmacro %}

{# Change against the comparison period: "+12 %" / "−5 %", direction as icon + sign (never colour alone) #}
{% macro delta(current, previous) %}
    {% import 'admin/_icons.html.twig' as icons %}
    {% if previous > 0 %}
        {% set change = ((current - previous) / previous * 100)|round %}
        <span class="admin-dash-delta {{ change > 0 ? 'is-up' : (change < 0 ? 'is-down' : 'is-flat') }}" title="Předtím: {{ previous|number_format(0, '', '.') }}">
            {%- if change != 0 %}{{ icons.icon(change > 0 ? 'arrow_up' : 'arrow_down') }}{% endif -%}
            {{ change > 0 ? '+' : (change < 0 ? '−' : '') }}{{ change|abs }} %
        </span>
    {% else %}
        <span class="admin-dash-delta is-flat" title="Ve srovnávacím období nic">–</span>
    {% endif %}
{% endmacro %}

{% macro kpi(title, comparison, current, previous) %}
    {% import _self as dashboard %}
    <div class="card admin-dash-kpi">
        <div class="card-body">
            <div class="admin-dash-kpi-title">{{ title }}</div>
            <div class="admin-dash-kpi-main">
                <span class="admin-dash-kpi-value">{{ dashboard.money(current.revenue) }}</span>
                {{ dashboard.delta(current.revenue, previous.revenue) }}
            </div>
            <dl class="admin-dash-kpi-list">
                <div><dt>Objednávek</dt><dd>{{ current.ordersCount }} {{ dashboard.delta(current.ordersCount, previous.ordersCount) }}</dd></div>
                <div><dt>Průměrná objednávka</dt><dd>{{ dashboard.money(current.averageOrder) }} {{ dashboard.delta(current.averageOrder, previous.averageOrder) }}</dd></div>
                <div><dt>Nové registrace</dt><dd>{{ current.registrations }} {{ dashboard.delta(current.registrations, previous.registrations) }}</dd></div>
            </dl>
            <div class="admin-dash-kpi-note">{{ comparison }}</div>
        </div>
    </div>
{% endmacro %}

{# Orders not sent to an integration: overdue (expedition today or earlier) is the problem, upcoming is info #}
{% macro attention(title, icon, overdue, upcoming, url) %}
    {% import 'admin/_icons.html.twig' as icons %}
    <a class="admin-dash-check{{ overdue > 0 ? ' is-danger' : (upcoming > 0 ? ' is-info' : ' is-ok') }}" href="{{ url }}">
        <span class="admin-tile-icon">{{ icons.icon(icon) }}</span>
        <span>
            <span class="admin-dash-check-title">{{ title }}</span>
            {% if overdue + upcoming == 0 %}
                <span class="admin-dash-check-value">{{ icons.icon('check') }} vše propsáno</span>
            {% else %}
                <span class="admin-dash-check-value">
                    {% if overdue > 0 %}<strong>{{ overdue }}</strong> s expedicí dnes či dříve{% endif %}
                    {% if overdue > 0 and upcoming > 0 %} · {% endif %}
                    {% if upcoming > 0 %}{{ upcoming }} nadcházejících{% endif %}
                </span>
            {% endif %}
            <span class="admin-dash-check-hint">nepropsané objednávky</span>
        </span>
    </a>
{% endmacro %}

{#
    Day card / 7-day strip day: a live action button selecting the day (`url` null, on "Co připravit"),
    or a link to "Co připravit" for that day (home overview, `url` = prefix the `Y-m-d` day is appended to).
#}
{% macro day_open(class, stats, selected, url) -%}
    {%- if url -%}
        <a class="{{ class }}" href="{{ url }}">
    {%- else -%}
        <button type="button" class="{{ class }}{{ stats.date == selected ? ' is-selected' }}"
            data-action="live#action" data-live-action-param="selectDay" data-live-day-param="{{ stats.date|date('Y-m-d', false) }}"
            aria-pressed="{{ stats.date == selected ? 'true' : 'false' }}">
    {%- endif -%}
{%- endmacro %}

{% macro day_card(title, stats, day_label, selected = null, url = null) %}
    {% import 'admin/_icons.html.twig' as icons %}
    {% import _self as dashboard %}
    {{ dashboard.day_open('card admin-dash-day', stats, selected, url ? url ~ stats.date|date('Y-m-d', false) : null) }}
        <span class="card-body">
            <span class="admin-dash-day-title">{{ title }} <span class="admin-dash-day-date">{{ dashboard.weekday(stats.date) }} {{ stats.date|date('j. n.', false) }} · {{ day_label }}</span></span>
            <span class="admin-dash-day-main">
                <span class="admin-dash-day-count">{{ stats.ordersCount }}</span>
                <span class="admin-dash-day-unit">{{ stats.ordersCount == 1 ? 'objednávka' : (stats.ordersCount in 2..4 ? 'objednávky' : 'objednávek') }}</span>
                <span class="admin-dash-day-revenue">{{ dashboard.money(stats.revenue) }}</span>
            </span>
            {% if stats.ordersCount > 0 %}
                <span class="admin-dash-channels">
                    {% for channel in stats.channels %}
                        <span class="admin-dash-channel"><span class="admin-dash-swatch" style="background: {{ channel.channel.color }}"></span>{{ channel.channel.label }} <strong>{{ channel.count }}</strong></span>
                    {% endfor %}
                </span>
                <span class="admin-dash-day-flags">
                    {% if stats.withNoteCount > 0 %}<span class="admin-pill is-info">{{ icons.icon('text') }}{{ stats.withNoteCount }}× poznámka</span>{% endif %}
                    {% if stats.pohodaMissingCount > 0 %}<span class="admin-pill is-danger">{{ icons.icon('alert') }}{{ stats.pohodaMissingCount }}× nepropsáno do Pohody</span>{% endif %}
                    {% if stats.boxxiMissingCount > 0 %}<span class="admin-pill is-danger">{{ icons.icon('alert') }}{{ stats.boxxiMissingCount }}× nepropsáno do Boxxi</span>{% endif %}
                </span>
            {% endif %}
        </span>
    {% if url %}</a>{% else %}</button>{% endif %}
{% endmacro %}

{% macro strip(days, selected = null, url = null) %}
    {% import _self as dashboard %}
    <div class="admin-dash-strip" role="group" aria-label="Příštích 7 dní">
        {% for stats in days %}
            {{ dashboard.day_open('admin-dash-strip-day' ~ (stats.ordersCount == 0 ? ' is-empty'), stats, selected, url ? url ~ stats.date|date('Y-m-d', false) : null) }}
                <span class="admin-dash-strip-date">{{ dashboard.weekday(stats.date) }} {{ stats.date|date('j. n.', false) }}</span>
                <span class="admin-dash-strip-count">{{ stats.ordersCount }}</span>
                <span class="admin-dash-strip-revenue">{{ dashboard.money(stats.revenue) }}</span>
            {% if url %}</a>{% else %}</button>{% endif %}
        {% endfor %}
    </div>
{% endmacro %}
