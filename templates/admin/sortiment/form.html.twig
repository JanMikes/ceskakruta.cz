{% extends 'admin/base.html.twig' %}
{% import 'admin/_icons.html.twig' as icons %}

{% set heading = item ? 'Upravit sortiment' : 'Přidat sortiment' %}

{% block title %}{{ heading }} – {{ category.name }}{% endblock %}

{% block content %}
    <div class="admin-page-header">
        <div class="admin-page-heading">
            <a class="admin-back" href="{{ path('admin_sortiment_category', {categoryId: category.id}) }}">{{ icons.icon('arrow_left') }}{{ category.name }}</a>
            <h1 class="admin-page-title">{{ heading }} <small class="text-muted">{{ item ? item.name : category.name }}</small></h1>
        </div>
    </div>

    <div class="card admin-form-card">
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_row(form.name) }}
                {{ form_row(form.text) }}

                {{ include('admin/_form_buttons.html.twig', {is_edit: item is not null, back_url: path('admin_sortiment_category', {categoryId: category.id})}) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
