{% extends 'admin/base.html.twig' %}
{% import 'admin/_grid.html.twig' as grid %}

{% block title %}Texty{% endblock %}

{% block content %}
    <div class="admin-page-header">
        <div class="admin-page-heading">
            <h1 class="admin-page-title">Texty</h1>
            <p class="admin-page-subtitle">Editovatelné texty jednotlivých sekcí webu.</p>
        </div>
    </div>

    <div class="card">
        <div class="admin-table-wrap admin-table-stack">
            <table class="table table-hover align-middle admin-table">
                <thead>
                    <tr>
                        <th>Sekce</th>
                        <th class="text-end">Akce</th>
                    </tr>
                </thead>
                <tbody>
                    {% for content in contents %}
                        <tr id="item-{{ content.id }}">
                            <td class="admin-cell-primary">{{ content.name }}</td>
                            <td class="admin-cell-actions">
                                <div class="admin-actions">
                                    {{ grid.edit_link(path('admin_content_edit', {id: content.id})) }}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        {{ grid.empty_row(2, 'Žádné texty.') }}
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
