{% extends 'admin/base.html.twig' %}

{% block title %}Upravit uživatele{% endblock %}

{% block content %}
    <h1 class="h3 mb-4">Upravit uživatele <small class="text-muted">{{ user.email }}</small></h1>

    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
                <div class="row">
                    <div class="col-md-4">{{ form_row(form.email) }}</div>
                    <div class="col-md-4">{{ form_row(form.name) }}</div>
                    <div class="col-md-4">{{ form_row(form.phone) }}</div>
                </div>

                <h2 class="h5 mt-3">Doprava</h2>
                <div class="row">
                    <div class="col-md-6">{{ form_row(form.preferred_place_id) }}</div>
                </div>
                <div class="row">
                    <div class="col-md-6">{{ form_row(form.delivery_street) }}</div>
                    <div class="col-md-4">{{ form_row(form.delivery_city) }}</div>
                    <div class="col-md-2">{{ form_row(form.delivery_zip) }}</div>
                </div>

                <h2 class="h5 mt-3">Fakturace</h2>
                {{ form_row(form.company_invoicing) }}
                <div class="row">
                    <div class="col-md-6">{{ form_row(form.company_name) }}</div>
                    <div class="col-md-3">{{ form_row(form.company_id) }}</div>
                    <div class="col-md-3">{{ form_row(form.company_vat_id) }}</div>
                    <div class="col-md-6">{{ form_row(form.invoicing_street) }}</div>
                    <div class="col-md-4">{{ form_row(form.invoicing_city) }}</div>
                    <div class="col-md-2">{{ form_row(form.invoicing_zip) }}</div>
                </div>

                <h2 class="h5 mt-3">Oprávnění</h2>
                {{ form_row(form.allow_wholesale) }}
                {{ form_row(form.is_ceskakruta) }}
                {{ form_row(form.is_admin) }}

                {{ include('admin/_form_buttons.html.twig', {is_edit: true, back_url: path('admin_users')}) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
