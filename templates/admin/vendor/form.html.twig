{% extends 'admin/base.html.twig' %}
{% import 'admin/_icons.html.twig' as icons %}

{% set heading = vendor ? 'Upravit prodejce' : 'Přidat prodejce' %}

{% block title %}{{ heading }}{% endblock %}

{% block content %}
    <div class="admin-page-header">
        <div class="admin-page-heading">
            <a class="admin-back" href="{{ path('admin_vendors') }}">{{ icons.icon('arrow_left') }}Prodejci</a>
            <h1 class="admin-page-title">{{ heading }}{% if vendor and vendor.name %} <small class="text-muted">{{ vendor.name }}</small>{% endif %}</h1>
        </div>
    </div>

    <div class="card admin-form-card">
        <div class="card-body">
            {{ form_start(form) }}
                <div class="admin-form-section">
                    <h2 class="admin-form-section-title">Prodejce</h2>
                    <div class="row">
                        <div class="col-md-6">{{ form_row(form.name) }}</div>
                        <div class="col-md-6">{{ form_row(form.place) }}</div>
                        <div class="col-md-6">{{ form_row(form.address) }}</div>
                        <div class="col-8 col-md-4">{{ form_row(form.city) }}</div>
                        <div class="col-4 col-md-2">{{ form_row(form.zip) }}</div>
                    </div>
                </div>

                <div class="admin-form-section">
                    <h2 class="admin-form-section-title">Kontakt</h2>
                    <div class="row">
                        <div class="col-md-4">{{ form_row(form.email) }}</div>
                        <div class="col-md-4">{{ form_row(form.web) }}</div>
                        <div class="col-md-4">{{ form_row(form.phone) }}</div>
                    </div>
                </div>

                {{ include('admin/_form_buttons.html.twig', {is_edit: vendor is not null, back_url: path('admin_vendors')}) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
