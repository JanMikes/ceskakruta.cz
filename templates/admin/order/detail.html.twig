{% extends 'admin/base.html.twig' %}
{% import 'admin/_icons.html.twig' as icons %}

{% block title %}Detail objednávky {{ record.order.id }}{% endblock %}

{% block content %}
    <div class="admin-page-header">
        <div class="admin-page-heading">
            <a class="admin-back" href="{{ path('admin_orders') }}">{{ icons.icon('arrow_left') }}Objednávky</a>
            <h1 class="admin-page-title">Detail objednávky</h1>
        </div>
        <div class="admin-page-actions">
            <a class="btn btn-primary btn-with-icon" href="{{ path('admin_order_edit', {id: record.order.id}) }}">{{ icons.icon('edit') }}<span>Upravit objednávku</span></a>
            <a class="btn btn-link" href="{{ path('admin_orders') }}">Zpět na seznam</a>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-xl-5">
            {{ include('admin/order/_summary.html.twig') }}
        </div>
        <div class="col-xl-7">
            {{ include('admin/order/_items.html.twig') }}
        </div>
    </div>
{% endblock %}
